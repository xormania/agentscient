  "decisions": [
    {"id": "D-plan-cue", "sentence": "A plan is prose plus a closed sidecar and every child is a digest-bound projection of a parent unit.", "premises": [{"text": "Plans are prose documents with closed sidecars and child plans are digest-bound projections of parent units.", "tag": "read", "source": "ops/docs/scratch/agentscient-framework-plan.md §3"}], "new": true, "ratified_by": "owner", "status": "standing"},
    {"id": "D-language", "sentence": "The dev-lane container is Python stdlib while CUE contracts and the fixture repository remain portable.", "premises": [{"text": "A compiled container can refuse registry, dependency, tag-flow, and interface defects before the first capability runs.", "tag": "read", "source": "ops/docs/scratch/agentscient-framework-plan.md §2"}], "new": true, "ratified_by": "conductor", "status": "standing"},
    {"id": "D-storage", "sentence": "One sqlite file per lane is owned by db while committed JSON exports remain evidence and the database remains a cache.", "premises": [{"text": "The dev lane's mini-apps are separate programs whose boundaries grew by accretion rather than from one framework contract.", "tag": "read", "source": "ops/docs/scratch/agentscient-framework-plan.md §1"}], "new": true, "ratified_by": "conductor", "status": "standing"},
    {"id": "D-set", "sentence": "The framework capability set includes task as the workflow capability and keeps the launcher pinned until the explicit cutover.", "premises": [{"text": "Task remains the workflow capability and the launcher stays pinned until explicit cutover.", "tag": "read", "source": "ops/docs/scratch/agentscient-u0-review-grok-a46183.md finding 1"}], "new": true, "ratified_by": "conductor", "status": "standing"},
    {"id": "D-context-custody", "sentence": "Fact custody is a framework capability distinct from harness isolation and follows the static checks unit.", "premises": [{"text": "The framework ratification separated fact custody from staged harness inputs.", "tag": "read", "source": "ops/docs/scratch/agentscient-u0-review-grok-a46183.md finding 1"}], "new": true, "ratified_by": "conductor", "status": "standing"},
    {"id": "D-size", "sentence": "The container proper is bounded at 2,000 lines by a gate, and the capability count is bounded only by the registry being closed.", "premises": [{"text": "A measured container bound resists the accretion that the framework replaces.", "tag": "read", "source": "ops/docs/scratch/agentscient-framework-plan.md §11 D-size"}], "new": true, "ratified_by": "conductor", "status": "standing"},
    {"id": "D-order", "sentence": "Plan gate and vocabulary come first, container second, primitives third, surface fourth, and the runner and cutover last.", "premises": [{"text": "Framework comes before surface and every unit after U0 must be vettable by U0's gate.", "tag": "read", "source": "ops/docs/scratch/agentscient-framework-plan.md §11 D-order"}], "new": true, "ratified_by": "conductor", "status": "standing"},
    {"id": "D-anatomy", "sentence": "A capability directory is a closed shape checked in both directions, and a scaffold command writes it.", "premises": [{"text": "Closure and positive and negative controls make the capability anatomy checkable.", "tag": "read", "source": "ops/docs/scratch/agentscient-framework-plan.md §11 D-anatomy"}], "new": true, "ratified_by": "conductor", "status": "standing"},
    {"id": "D-fixture-repo", "sentence": "The fixture capability grows a manifest-driven repository builder that proves its own plant and is the only end-to-end ground and later-container conformance suite.", "premises": [{"text": "The conductor cannot use the framework it builds, and an unproved fixture plant answers about nothing.", "tag": "read", "source": "ops/docs/scratch/agentscient-framework-plan.md §11 D-fixture-repo"}], "new": true, "ratified_by": "conductor", "status": "standing"},
    {"id": "D-hooks-listeners", "sentence": "Hooks are registered as listeners, not made a capability, because nothing injects them.", "premises": [{"text": "Hooks are invoked by git and the harness rather than called through an injected interface.", "tag": "read", "source": "ops/docs/scratch/agentscient-framework-plan.md §11 D-hooks-listeners"}], "new": true, "ratified_by": "conductor", "status": "standing"},
    {"id": "D-launcher-after", "sentence": "Moving the launcher and levers under the framework is a separate plan after U21, gated on records and custody having been in capability.", "premises": [{"text": "The launcher is pinned and its read half is copied rather than moved in this plan.", "tag": "read", "source": "ops/docs/scratch/agentscient-framework-plan.md §11 D-launcher-after"}], "new": true, "ratified_by": "conductor", "status": "standing"},
    {"id": "D-new-2", "sentence": "The interface-projection decision is superseded by D-U2-iface-manifest: interface members are declared in the manifest and verified in both directions while the 3.12.14 pin stands.", "premises": [{"text": "D-U2-iface-manifest replaces introspection with a portable declared member list.", "tag": "read", "source": "ops/docs/scratch/agentscient-u2-ratification.md Amendment U2-A1 and D-U2-iface-manifest"}], "new": true, "ratified_by": "conductor", "status": "superseded"}
  ],
