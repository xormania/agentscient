{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "organization": "GitHub",
          "semanticVersion": "2.20.4",
          "informationUri": "https://codeql.github.com",
          "rules": [
            {
              "id": "py/command-line-injection",
              "name": "py/command-line-injection",
              "shortDescription": {
                "text": "Command built from user-controlled sources"
              },
              "fullDescription": {
                "text": "The application constructs a command from user-controlled data, which can allow an attacker to execute arbitrary commands."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://codeql.github.com/codeql-query-help/python/py-command-line-injection",
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-078",
                  "external/cwe/cwe-088"
                ],
                "precision": "high",
                "kind": "path-problem",
                "security-severity": "9.8"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "py/command-line-injection",
          "ruleIndex": 0,
          "message": {
            "text": "This command depends on a user-provided value."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "findable.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 12,
                  "startColumn": 5,
                  "endColumn": 48
                }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "codeql-proof-fixture:1"
          }
        }
      ],
      "columnKind": "utf16",
      "properties": {
        "recorded": "2026-08-30",
