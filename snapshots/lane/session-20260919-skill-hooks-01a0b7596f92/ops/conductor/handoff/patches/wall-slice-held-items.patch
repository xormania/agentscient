+                       tools=("Bash", "Write", "Edit", "MultiEdit"),
+                       when={"pred": "wall_path_dirty"}))
+        self.wall = self.repo / WALL_PATH
+        self.wall.parent.mkdir(parents=True, exist_ok=True)
+        self.wall.write_text('{"jobs": {"tests": {"caps": {"turns": 150}}}}\n', encoding="utf-8")
+        self.neighbour = self.repo / NEIGHBOUR_PATH
+        self.neighbour.parent.mkdir(parents=True, exist_ok=True)
+        self.neighbour.write_text("# the ledger\n", encoding="utf-8")
+        support.git(self.repo, self.env, "add", "-A")
+        support.git(self.repo, self.env, "commit", "-q", "-m", "the wall and a neighbour")
+        self.store = self.home / ".local" / "state" / "agentscient" / "handwork.db"
+        self.assertEqual(self.dirt(), "", "INVALID: the fixture tree did not start clean")
+
+    def dirt(self):
+        return support.git(self.repo, self.env, "status", "--porcelain").stdout.strip()
+
+    def grant(self, grant_id, lever_class):
+        """One open grant of ``lever_class`` in the lane's store."""
+        self.store.parent.mkdir(parents=True, exist_ok=True)
+        with sqlite3.connect(self.store) as conn:
+            conn.execute(HANDWORK_DDL)
+            conn.execute(
+                "INSERT INTO handwork (id, ts, session, agent, action, why_by_hand, lever_class, status)"
+                " VALUES (?, '2026-09-16T00:00:00Z', 's1', 'tester', 'the slice', 'the owner said so', ?, 'open')",
+                (grant_id, lever_class))
+            conn.commit()
+            landed = conn.execute("SELECT status, lever_class FROM handwork WHERE id = ?", (grant_id,)).fetchone()
