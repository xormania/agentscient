{
  "autoCompactWindow": 300000,
  "permissions": {
    "allow": [
      "Bash(cd *)",
      "Bash(git *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh variable list *)",
      "Bash(composer *)",
      "Bash(php *)",
      "Bash(bin/console *)",
      "Bash(vendor/bin/phpunit*)",
      "Bash(bash ops/bin/*)",
      "Bash(sh ops/devlane/hooks/install.sh*)",
      "Bash(python3 ops/*)",
      "Bash(python3 -m unittest *)",
      "Bash(ruff *)",
      "Bash(cue *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/context-precheck.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|mcp__serena__(replace|insert|rename|safe_delete).*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/matrix.py"
          },
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/engine.py"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/skill-use.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/context-boundary.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/test-guard-hook.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|mcp__serena__(replace|insert|rename|safe_delete).*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/ruff-after-edit.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/engine.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/engine.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/onboard-on-compact.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/trunk-forward.py"
          },
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/engine.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/engine.py"
          }
        ]
      }
    ]
  }
}
