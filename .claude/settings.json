{
  "permissions": {
    "allow": [
      "Bash(cd *)",
      "Bash(git *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh variable list *)",
      "Bash(composer *)",
      "Bash(php *)",
      "Bash(bin/console *)",
      "Bash(vendor/bin/phpunit*)",
      "Bash(bash ops/bin/*)",
      "Bash(sh ops/devlane/hooks/install.sh*)",
      "Bash(python3 ops/*)",
      "Bash(python3 -m unittest *)",
      "Bash(ruff *)",
      "Bash(cue *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push * :*)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git branch --delete *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard*)",
      "Bash(git filter-branch*)",
      "Bash(git commit --amend*)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune*)",
      "Bash(gh pr merge --squash*)",
      "Bash(gh pr merge --rebase*)",
      "Bash(gh pr merge * --delete-branch*)",
      "Bash(gh pr merge * -d*)",
      "Bash(gh pr merge * --squash*)",
      "Bash(gh pr merge * --rebase*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/context-precheck.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|mcp__serena__(replace|insert|rename|safe_delete).*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/matrix.py"
          },
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/engine.py"
          }
        ]
      },
      {
        "matcher": "Agent|Workflow|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/no-subagents.py"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/skill-use.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/context-boundary.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/test-guard-hook.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|mcp__serena__(replace|insert|rename|safe_delete).*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/ruff-after-edit.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/engine.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/engine.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/onboard-on-compact.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/trunk-forward.py"
          },
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/engine.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/ops/devlane/hooks/claude/engine.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "done gate for the agentscient lane. Input: $ARGUMENTS. Read last_assistant_message only. Block only when BOTH hold: (a) the message reports the session's deliverable, order, task, plan or migration to the owner as done, complete, finished, landed, all done, fully migrated or ready, as a claim of completion and not as a question, a plan of what will be done, or a quotation of the owner's words; and (b) the message contains no pasted output of deliverable.py, which has exactly three shapes: a line beginning 'done lane/' (the done verb, met); a line beginning 'target: expected the measure to read' (the done verb's refusal, carrying the found reading); or a line beginning 'target lane/' and carrying '; reading ' and 'met' or 'short' (the show verb). When both hold respond exactly {\"ok\": false, \"reason\": \"done gate: the reply reports done without the lock's reading. Run python3 ops/conductor/tools/deliverable.py done <branch> for each branch this session named in the lock and paste its line verbatim into the reply; if it refuses, replace the claim with the reading and the word short; if the lock names no target for this session, paste deliverable.py show and say so.\"}. In every other case, including a message that already carries such a line, a status that says short with a reading, a message with no completion claim, or stop_hook_active true with a reading present, respond {\"ok\": true}.",
            "timeout": 30,
            "statusMessage": "done gate"
          }
        ]
      }
    ]
  }
}
